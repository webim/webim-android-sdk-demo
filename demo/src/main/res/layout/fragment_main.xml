<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackgroundActivityMain"
    android:gravity="center"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    tools:context="ru.webim.android.demo.MainActivity">

    <ImageView
        android:id="@+id/imageViewLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="108dp"
        android:contentDescription="@string/image_logo_content_description"
        android:src="@drawable/logo_app"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/welcomeTitleTextView"
        style="@style/TextView_700_18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="48dp"
        android:lineSpacingMultiplier="1.3"
        android:text="@string/welcome_title"
        android:textColor="@color/white"
        android:textDirection="locale"
        android:textAlignment="textStart"/>

    <TextView
        android:id="@+id/welcomeSubtitleTextView"
        style="@style/TextView_400_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="16dp"
        android:lineSpacingMultiplier="1"
        android:text="@string/welcome_subtitle"
        android:textColor="@color/white"
        android:textDirection="locale"
        android:textAlignment="textStart"/>

    <TextView
        android:id="@+id/welcomeDescriptionTextView"
        style="@style/TextView_400_15"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="16dp"
        android:autoLink="web"
        android:lineSpacingMultiplier="1.03"
        android:linksClickable="true"
        android:text="@string/welcome_description"
        android:textColor="@color/white"
        android:textDirection="locale"
        android:textAlignment="textStart"/>

    <LinearLayout
        android:id="@+id/linearLayoutNewMessages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingHorizontal="6dp"
            android:paddingTop="6dp"
            android:paddingBottom="2dp"
            android:src="@drawable/ic_new_message" />

        <TextView
            android:id="@+id/newMessagesTextView"
            style="@style/TextView_500_14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/roboto_medium"
            android:textColor="@color/white"
            tools:text="Новых сообщений: 5" />


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/buttonOnboarding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/background_button_chat"
        android:text="@string/button_text_start_onboarding"
        android:theme="@style/AppTheme.MainScreenButtons" />

    <Button
        android:id="@+id/buttonStartChat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/background_button_chat"
        android:elevation="0dp"
        android:text="@string/button_text_start_chat"
        android:theme="@style/AppTheme.MainScreenButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/buttonSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="15dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/background_button_settings"
        android:text="@string/button_text_settings"
        android:theme="@style/AppTheme.MainScreenButtons" />

</LinearLayout>
